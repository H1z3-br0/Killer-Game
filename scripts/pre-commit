#!/usr/bin/env bash
# Проверки перед коммитом: линтер, секреты, состав репозитория, тесты.
# Ставится командой `make hooks`. Пропустить разово: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/python ]; then
  echo "pre-commit: окружения нет, пропускаю"
  exit 0
fi

echo "pre-commit: линтер…"
.venv/bin/ruff check . --quiet

echo "pre-commit: секреты и состав…"
bash scripts/check-secrets.sh >/dev/null
bash scripts/check-repo.sh >/dev/null

echo "pre-commit: тесты…"
.venv/bin/python -m pytest tests/ -q --no-header >/dev/null

echo "pre-commit: всё в порядке"
