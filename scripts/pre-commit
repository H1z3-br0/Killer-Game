#!/usr/bin/env bash
# Прогоняет тесты перед коммитом. Ставится командой `make hooks`.
# Пропустить разово: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/python ]; then
  echo "pre-commit: окружения нет, пропускаю тесты"
  exit 0
fi

echo "pre-commit: тесты…"
.venv/bin/python tests/test_flow.py >/dev/null
.venv/bin/python tests/test_service.py >/dev/null
echo "pre-commit: в порядке"
