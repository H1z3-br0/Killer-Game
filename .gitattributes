# Единые переводы строк в репозитории, родные — в рабочей копии.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Шрифты — бинарники: diff по ним бессмыслен.
*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.db binary

# Шрифты не должны считаться исходниками в статистике языков.
app/static/fonts/** linguist-vendored
